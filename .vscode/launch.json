{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch renderer (chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "renderer: dev (ng serve)",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/apps/renderer"
    },
    {
      "name": "Debug server (tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@shader-studio/server", "exec", "tsx", "--inspect-brk", "src/index.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug mcp server (tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@shader-studio/mcp", "exec", "tsx", "--inspect-brk", "src/server.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
