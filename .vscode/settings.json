{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "oxc.fmt.configPath": ".oxfmtrc.json",

  // oxfmt only handles JS/TS/JSON; everything else keeps its own formatter.
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[glsl]": { "editor.formatOnSave": false },

  "js/ts.tsdk": "apps/web/node_modules/typescript/lib",
  "js/ts.enablePromptUseWorkspaceTsdk": true,
  "js/ts.preferences.autoImportFileExcludePatterns": ["**/dist/**", "**/dist-*/**"],

  "files.associations": {
    "*.glsl": "glsl",
    "*.frag": "glsl",
    "*.vert": "glsl",
    "*.wgsl": "wgsl"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": true,
    "**/dist": true,
    "**/dist-main": true,
    "**/dist-renderer": true,
    "**/dist-web": true,
    "**/release": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/dist-main": true,
    "**/dist-renderer": true,
    "**/dist-web": true,
    "**/release": true,
    "**/pnpm-lock.yaml": true,
    "data/**": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/dist-main/**": true,
    "**/dist-renderer/**": true,
    "**/dist-web/**": true,
    "**/release/**": true,
    "**/.angular/**": true
  },

  "[markdown]": {
    "editor.formatOnSave": false
  },

  "eslint.enable": false,
  "npm.packageManager": "pnpm",
  "npm.enableRunFromFolder": true
}
