{
  "servers": {
    "angular-cli": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@angular/cli@22", "mcp"]
    },
    "shader-studio": {
      "type": "stdio",
      "command": "node",
      "args": ["tools/mcp/dist/server.mjs"],
      "env": {
        "SHADER_STUDIO_MCP_PORT": "4310",
        "SHADER_STUDIO_MCP_TOKEN": "shader-studio-dev-token"
      }
    }
  }
}
