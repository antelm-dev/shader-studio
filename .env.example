# Copy to `.env` and adjust. Used by docker-compose.yml. Never commit real secrets.

# --- PostgreSQL (Web / Docker) ----------------------------------------------
# Database name and user created inside the postgres container.
POSTGRES_DB=shader_studio
POSTGRES_USER=shader_studio
# Required — Compose refuses to start without it. Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# The connection string the app uses. Compose builds this for you from the three
# values above, so you normally do NOT need to set it here. Override only if you
# point the app at an external PostgreSQL instead of the bundled one.
# DATABASE_URL=postgres://shader_studio:change-me@postgres:5432/shader_studio

# --- App ---------------------------------------------------------------------
# Host port the app is published on (container always listens on 4000).
SHADER_PORT=4000

# Set to 0 to start with an empty library instead of seeding it from examples/.
SHADER_SEED=1

# Comma-separated hostnames the SSR engine will answer for. Add your machine
# name or domain when reaching the app as something other than localhost.
SHADER_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
