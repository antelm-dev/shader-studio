{
  "name": "@shader-studio/workspace-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm check:i18n && pnpm check:fonts && pnpm check:ipc",
    "check:i18n": "tsx src/check/i18n.ts",
    "check:fonts": "tsx src/check/fonts.ts",
    "check:ipc": "tsx src/check/ipc.ts",
    "generate:fonts": "tsx src/generate/fonts.ts",
    "smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "playwright": "^1.57.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2"
  },
  "nx": {
    "targets": {
      "check": {
        "cache": false
      },
      "check:i18n": {
        "cache": false
      },
      "check:fonts": {
        "cache": false
      },
      "check:ipc": {
        "cache": false
      },
      "generate:fonts": {
        "cache": false,
        "outputs": [
          "{workspaceRoot}/apps/web/src/app/editor/font-catalogue.ts"
        ]
      },
      "smoke": {
        "cache": false
      }
    }
  }
}
