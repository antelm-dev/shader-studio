{
  "name": "@shader-studio/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:pg-native --outfile=../../dist/shader-studio/cli.mjs",
    "migrate:files": "tsx src/cli.ts migrate-files",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "nx": {
    "targets": {
      "build:cli": {
        "outputs": [
          "{workspaceRoot}/dist/shader-studio/cli.mjs"
        ]
      },
      "dev": {
        "cache": false,
        "persistent": true
      }
    }
  },
  "dependencies": {
    "@angular/ssr": "^22.0.6",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@shader-studio/backend": "workspace:*",
    "@shader-studio/shared": "workspace:*",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
