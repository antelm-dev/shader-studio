{
  "permissions": {
    "allow": ["Bash(pnpm *)", "Bash(git *)", "Bash(node *)", "Bash(tsx *)", "Read", "Glob", "Grep"],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm install *)",
      "Bash(pnpm publish *)",
      "Bash(pnpm dlx *)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "f=$(node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);process.stdout.write((j.tool_input&&j.tool_input.file_path)||'')}catch(e){}})\"); case \"$f\" in *.ts|*.tsx|*.js|*.mjs|*.cjs) node_modules/.bin/oxfmt \"$f\" 2>/dev/null || true;; esac",
            "statusMessage": "Formatting with oxfmt..."
          }
        ]
      }
    ]
  }
}
