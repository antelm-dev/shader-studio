meta {
  name: Sign in
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{baseUrl}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("sign-in succeeded", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
