{
  "name": "shader-studio",
  "version": "1.1.0",
  "private": true,
  "description": "A shader collection viewer and editor: browse, edit, tune and share WebGL shaders.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "Adel Terki",
  "type": "module",
  "main": "dist-main/main.cjs",
  "scripts": {
    "dev": "nx run @shader-studio/web:dev",
    "dev:server": "nx run @shader-studio/server:dev",
    "dev:desktop": "nx run @shader-studio/desktop:dev",
    "dev:mcp": "nx run @shader-studio/mcp:dev",
    "build": "nx run @shader-studio/web:build",
    "build:all": "nx run-many -t build --projects \"@shader-studio/web,@shader-studio/mcp\" && nx run @shader-studio/server:build:cli",
    "build:desktop": "nx run @shader-studio/desktop:build",
    "build:mcp": "nx run @shader-studio/mcp:build",
    "serve:ssr": "node dist/shader-studio/server/server.mjs",
    "test": "nx run-many -t test --projects \"@shader-studio/*\"",
    "test:watch": "nx run @shader-studio/web:test:watch",
    "test:mcp": "nx run @shader-studio/mcp:test",
    "typecheck": "pnpm gen:ipc && pnpm typecheck:scripts && nx run-many -t typecheck --projects \"@shader-studio/*\"",
    "typecheck:mcp": "nx run @shader-studio/mcp:typecheck",
    "typecheck:scripts": "nx run @shader-studio/workspace-tools:typecheck",
    "check": "pnpm check:i18n && pnpm check:fonts && pnpm check:ipc",
    "check:i18n": "nx run @shader-studio/workspace-tools:check:i18n",
    "check:fonts": "nx run @shader-studio/workspace-tools:check:fonts",
    "check:ipc": "nx run @shader-studio/workspace-tools:check:ipc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "smoke": "nx run @shader-studio/workspace-tools:smoke",
    "gen:ipc": "nx run @shader-studio/desktop:gen:ipc",
    "gen:fonts": "nx run @shader-studio/workspace-tools:generate:fonts",
    "pack:desktop": "nx run @shader-studio/desktop:pack:dir",
    "pack:win": "nx run @shader-studio/desktop:pack:win",
    "dist:win": "nx run @shader-studio/desktop:dist:win",
    "pack:mcp": "nx run @shader-studio/mcp:pack:tarball",
    "verify:mcp": "nx run @shader-studio/mcp:verify",
    "affected": "nx affected",
    "graph": "nx graph",
    "ci": "pnpm lint && pnpm format:check && pnpm check && pnpm typecheck && pnpm test && pnpm build:all"
  },
  "devDependencies": {
    "@nx/angular": "23.1.0",
    "@nx/nest": "23.1.0",
    "nx": "23.1.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "volta": {
    "node": "26.5.0"
  },
  "packageManager": "pnpm@10.28.2"
}
