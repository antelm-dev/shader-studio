{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "dist-main/**",
    "dist-renderer/**",
    "dist-web/**",
    "release/**",
    "data/**",
    "libs/desktop-api/src/ipc-bridge.ts"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/studio/src/app/**",
        "apps/studio/src/main.ts",
        "apps/studio/src/main.desktop.ts",
        "apps/studio/src/main.server.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@shadergrove/api",
                "message": "The Angular app must not import the server: src/server and @shadergrove/api run in Node only, beside the app, and are mounted by src/server/index.ts."
              },
              {
                "name": "electron",
                "message": "Electron APIs belong in src/desktop; the Angular renderer uses @shadergrove/desktop-api."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/server",
                  "**/server/**",
                  "**/desktop/main",
                  "**/desktop/main/**",
                  "**/desktop/preload",
                  "**/desktop/preload/**"
                ],
                "message": "The Angular app must not import Node entry points from src/server or src/desktop."
              }
            ]
          }
        ]
      }
    }
  ]
}
