{
  "name": "@shader-studio/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./library": {
      "types": "./src/library/index.ts",
      "default": "./src/library/index.ts"
    },
    "./persistence": {
      "types": "./src/persistence/index.ts",
      "default": "./src/persistence/index.ts"
    },
    "./persistence/sqlite": {
      "types": "./src/persistence/sqlite/index.ts",
      "default": "./src/persistence/sqlite/index.ts"
    },
    "./persistence/postgres": {
      "types": "./src/persistence/postgres/index.ts",
      "default": "./src/persistence/postgres/index.ts"
    },
    "./persistence/legacy": {
      "types": "./src/persistence/legacy-files/index.ts",
      "default": "./src/persistence/legacy-files/index.ts"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "default": "./src/storage/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n-catalog.ts",
      "default": "./src/i18n-catalog.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shader-studio/shared": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.10",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
